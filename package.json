{
  "name": "open_deck_desktop",
  "productName": "Open-Deck",
  "version": "1.0.0",
  "description": "Open-Deck",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --opd-debug",
    "licenses:scan": "license-checker-rseidelsohn --json --out build_license/licenses.json",
    "licenses:html": "node build_scripts/create_licenses_html.js",
    "licenses": "npm run licenses:scan && npm run licenses:html"
  },
  "author": "kawa-nobu",
  "license": "MIT",
  "repository": "github:kawa-nobu/Open-Deck-Desktop",
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "work.kwdev.opdapp.release",
    "files": [
      "opd_resource/*",
      "opd_resource/icon/*",
      "package.json",
      "main.js",
      "about_opd_preload.js",
      "preload.js",
      "preload_session_manager.js",
      "preload_system_settings.js",
      "preload_webview.js"
    ],
    "extraResources": [
      {
        "from": "build_license/OPD_Use_Software_License.html",
        "to": "OPD_Use_Software_License.html"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "./OpenDeck_App_Logo.png"
    },
    "win": {
      "target": "zip",
      "icon": "./OpenDeck_App_Logo.png"
    },
    "linux": {
      "target": "zip",
      "icon": "./OpenDeck_App_Logo.png"
    }
  },
  "dependencies": {
    "license-checker-rseidelsohn": "^4.4.2"
  }
}
