{
  "name": "open_deck_desktop",
  "productName": "Open-Deck-Prototype",
  "version": "0.0.2",
  "description": "Open-Deck-Prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --opd-debug"
  },
  "author": "kawa-nobu",
  "license": "MIT",
  "repository": "github:kawa-nobu/Open-Deck-Desktop",
  "devDependencies": {
    "electron": "^32.0.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "work.kwdev.opdapp.prototype",
    "files": [
      "opd_resource/*",
      "opd_resource/icon/*",
      "opd_resource/sound/*",
      "package.json",
      "main.js",
      "about_opd_preload.js",
      "preload.js",
      "preload_session_manager.js",
      "preload_system_settings.js",
      "preload_webview.js"
    ],
    "mac": {
      "target": "dmg",
      "icon": "./OpenDeck_App_Logo.png"
    },
    "win": {
      "target": "zip",
      "icon": "./OpenDeck_App_Logo.png"
    },
    "linux": {
      "target": "zip",
      "icon": "./OpenDeck_App_Logo.png"
    }
  }
}
